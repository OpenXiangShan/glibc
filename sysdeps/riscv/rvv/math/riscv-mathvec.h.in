/* Do not edit this file directly.  */

/* ABI mask bits, low to high, one nibble per LMUL: m1 fixed-N, m1 Nx-N,
   m1 fixed-M, m1 Nx-M, then the same four for m2, m4 and m8.  A zero function
   mask means the installed library promises no vector entry for that
   function.  Each mask is defined twice: the full 16-bit value is used only
   when the compiler advertises __riscv_simd_math_abi_v1_lmul8, and the
   historical eight-bit LMUL1/2 subset is used otherwise, because a compiler
   that predates the wider mask rejects an argument above 255.  */
@MATHVEC_C_DEFINES@
